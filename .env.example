# ============================================================
# Finance Advisor AI - Environment Configuration
# Copy this file to `.env` and fill in your keys.
# The app works without an LLM key (falls back to analytics engine),
# but real market data is fetched live via yfinance (no key required).
# ============================================================

# --- App ---
APP_NAME=Finance Advisor API
DEBUG=False
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Local development only (default)
DATABASE_URL=sqlite:///./finance_advisor.db
# Railway MySQL production format. URL-encode special characters in USER and
# PASSWORD (for example @ -> %40, : -> %3A, / -> %2F).
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Security ---
# !!! CHANGE THIS to a long random string in production !!!
JWT_SECRET_KEY=CHANGE_ME_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI / LLM (optional but recommended) ---
# Primary: Google Gemini
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Fallback: OpenAI (optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Market Data (optional) ---
# Alpha Vantage is optional; yfinance is used by default and needs no key.
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_CACHE_PATH=./datasets/market_cache
MARKET_LOOKBACK_YEARS=5
ENABLE_LIVE_MARKET_DATA=true

# --- Redis (optional caching) ---
# REDIS_URL=redis://localhost:6379/0

# --- Models ---
MODEL_STORAGE_PATH=./datasets/trained_models
DATASETS_RAW_PATH=./datasets/raw
DATASETS_PROCESSED_PATH=./datasets/processed
